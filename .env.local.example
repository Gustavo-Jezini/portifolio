# Email provider (Resend) - https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"

# Destination inbox
CONTACT_TO_EMAIL="youremail@email.com"

# Sender identity (must be a verified sender/domain in Resend)
# While testing you can keep onboarding@resend.dev, but for production set your own verified domain.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
